---
// Inscription à la newsletter via un formulaire Brevo (voir site.brevoForm).
// Le formulaire est envoyé directement à Brevo, qui renvoie ensuite vers /merci/
// (adresse de redirection à régler dans Brevo).
import { site } from "../site";

const subject = encodeURIComponent("Inscription à la newsletter");
const body = encodeURIComponent("Bonjour Cécile,\n\nJe souhaite recevoir les dates des ateliers et les actualités du cabinet.\n\nMerci !");
const mailto = `mailto:${site.email}?subject=${subject}&body=${body}`;
---

<section id="newsletter" class="newsletter">
  <div class="wrap newsletter__inner">
    <h2>Newsletter</h2>
    <p>
      Inscrivez-vous à la newsletter du Cabinet de Cécile pour connaître les dates des ateliers et les actualités du
      cabinet.
    </p>

    {
      site.brevoForm ? (
        <form class="newsletter__form" method="POST" action={site.brevoForm}>
          <label class="visually-hidden" for="newsletter-email">Adresse e-mail</label>
          <input id="newsletter-email" type="email" name="EMAIL" placeholder="Adresse e-mail" autocomplete="email" required />
          {/* Champ piège à robots de Brevo : doit rester vide */}
          <input class="visually-hidden" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="locale" value="fr" />
          <button class="btn" type="submit">S’inscrire</button>
        </form>
      ) : (
        <div class="newsletter__form">
          <a class="btn" href={mailto}>S’inscrire par e-mail</a>
        </div>
      )
    }

    {
      site.brevoForm && (
        <p class="newsletter__note">
          Un e-mail de confirmation vous sera envoyé. Désinscription en un clic depuis chaque envoi.
          <a href="/mentions-legales/#donnees">Données personnelles</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .newsletter {
    padding: 0 12px clamp(56px, 8vw, 100px);
  }
  .newsletter__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px);
    border-radius: var(--radius-lg);
    background: var(--lavender-soft);
    text-align: center;
  }
  .newsletter h2 {
    font-size: clamp(28px, 3.4vw, 40px);
  }
  .newsletter p {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    font-size: 15.5px;
  }
  .newsletter__form {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 28px auto 16px;
    max-width: 480px;
  }
  form.newsletter__form {
    padding: 6px;
    border-radius: 999px;
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .newsletter__form input[type="email"] {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 15px;
  }
  .newsletter .newsletter__note {
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    form.newsletter__form {
      flex-direction: column;
      border-radius: var(--radius-sm);
    }
  }
</style>
